{
  "version": 2,
  "updated": "2026-10-20",
  "purpose": "构件契约清单——语义路由（内容卡语义 → 选件）与泛化回归测试的唯一基准。构造配方仍以 reference/*.md 为权威；本文件只做路由辅助与测试基准，不引入新 QA 规则。唯一设计权威 = SKILL.md 十条铁律 + design-tokens.md。 v2：融合 ppt-master 策划/图解纪律（planning.md / diagrams.md / shape-vocabulary.md；D 族图解构件）。",
  "composition_model": {
    "layout_rule": "每页恰好一个 layout。composition=fixed 的布局（L01/L02/L03 + chrome）照抄骨架改文案，不参与自由组合；L04 是唯一自由组合画布。",
    "slot_rule": "band-full 独占展区主位；band-column 与 band-column/band-strip 自由共存；band-strip 每页 ≤2 条且可与 band-full/band-column 共存；inline 不占槽位（活在其他组件内）。一栏只放一个主展区（铁律 9）。条目级 composes_with 契约优先于槽位独占的字面表述。",
    "density_rule": "组件数量不设硬上限（1–4 是经验指导），密度由 qa.mjs page_density/page_sparse 机械闸兜底；本模板实测密度高，IC 档目标元素中位 ~70、短条 ~14。",
    "canonical_rule": "composition=canonical 的构件内部构造永远按 reference 配方，自由的是「选哪几件、怎么摆」，不是「改写构件本身」。",
    "composes_rule": "composes_with 是「已验证合法组合」的非穷尽清单，任一侧条目列出即视为契约内；不在清单不等于非法——清单外组合按 slot/conflicts/密度规则裁决，首次走出后回补清单。"
  },
  "global_qa_rules": [
    "yaml_parse",
    "bounds_check",
    "style_ref_exists",
    "min_font",
    "font_scale_whitelist",
    "palette_closed",
    "shape_rules",
    "font_family_discipline",
    "img_src_exists",
    "media_image_weight",
    "svg_no_comments",
    "element_collision",
    "z_order_cover",
    "z_order_occlusion",
    "text_width_estimate",
    "title_render_lines",
    "placeholder_leftover",
    "no_nbsp",
    "rule_as_rect",
    "peer_font_consistency",
    "page_density",
    "page_sparse",
    "ai_slop",
    "dash_density",
    "not_but_parallel",
    "explainer_preamble",
    "dual_accent_limit",
    "logo_placeholder_left",
    "text_contrast",
    "orphan_line",
    "plan_contract",
    "page_rhythm_mismatch",
    "page_rhythm_flat",
    "closing_missing"
  ],
